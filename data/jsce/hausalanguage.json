[
  { "id": 1, "text": "Mene ne sunan babban birnin Najeriya?", "options": { "A": "Lagos", "B": "Kano", "C": "Abuja", "D": "Kaduna" }, "correct": "C", "explanation": "Abuja is the capital city of Nigeria." },
  { "id": 2, "text": "Yaya ake cewa 'Good Morning' da Hausa?", "options": { "A": "Ina kwana", "B": "Ina wuni", "C": "Sanu da zuwa", "D": "Sai an jima" }, "correct": "A", "explanation": "'Ina kwana' is the greeting for morning." },
  { "id": 3, "text": "Wane ne shugaban gidan Hausa?", "options": { "A": "Uwa", "B": "Uba", "C": "Yaya", "D": "Kanwa" }, "correct": "B", "explanation": "'Uba' (Father) is the head of the household." },
  { "id": 4, "text": "Mene ne jam'in 'Yaro'?", "options": { "A": "Yara", "B": "Yaru", "C": "Yaraye", "D": "Yarawa" }, "correct": "A", "explanation": "The plural of 'Yaro' (Boy) is 'Yara' (Children)." },
  { "id": 5, "text": "Wane launi ne 'Fari'?", "options": { "A": "Black", "B": "Red", "C": "White", "D": "Blue" }, "correct": "C", "explanation": "'Fari' means White." },
  { "id": 6, "text": "Me ake nufi da 'Ruwa'?", "options": { "A": "Food", "B": "Water", "C": "Air", "D": "Fire" }, "correct": "B", "explanation": "'Ruwa' translates to Water." },
  { "id": 7, "text": "Wane dabba ne 'Zaki'?", "options": { "A": "Elephant", "B": "Lion", "C": "Goat", "D": "Dog" }, "correct": "B", "explanation": "'Zaki' is the Hausa word for Lion." },
  { "id": 8, "text": "Karasa wannan karin maganar: 'Gani ya kori ______.'", "options": { "A": "Gudu", "B": "Ji", "C": "Tsoro", "D": "Karya" }, "correct": "B", "explanation": "Seeing dispels hearing (Seeing is believing)." },
  { "id": 9, "text": "Wane ne Sarkin Musulmi na yanzu?", "options": { "A": "Emir of Kano", "B": "Sultan of Sokoto", "C": "Shehu of Borno", "D": "Etsu Nupe" }, "correct": "B", "explanation": "The Sultan of Sokoto is the Sarkin Musulmi." },
  { "id": 10, "text": "Mene ne 'Hanci' a Turanci?", "options": { "A": "Hand", "B": "Nose", "C": "Mouth", "D": "Eye" }, "correct": "B", "explanation": "'Hanci' means Nose." },
  { "id": 11, "text": "Wacce rana ce 'Jumma'a'?", "options": { "A": "Monday", "B": "Wednesday", "C": "Friday", "D": "Sunday" }, "correct": "C", "explanation": "'Jumma'a' corresponds to Friday." },
  { "id": 12, "text": "Yaya ake rubuta lamba 10 da Hausa?", "options": { "A": "Goma", "B": "Biyar", "C": "Uku", "D": "Tara" }, "correct": "A", "explanation": "'Goma' is the number 10." },
  { "id": 13, "text": "Mene ne kishiyar 'Sama'?", "options": { "A": "Kasa", "B": "Baya", "C": "Gaba", "D": "Tsakiya" }, "correct": "A", "explanation": "Opposite of 'Sama' (Up) is 'Kasa' (Down)." },
  { "id": 14, "text": "Wane ne ya kafa Daular Sokoto?", "options": { "A": "Aminu Kano", "B": "Usman Dan Fodio", "C": "Tafawa Balewa", "D": "Ahmadu Bello" }, "correct": "B", "explanation": "Usman Dan Fodio founded the Sokoto Caliphate." },
  { "id": 15, "text": "'Abinci' na nufin me?", "options": { "A": "Water", "B": "Food", "C": "Clothes", "D": "House" }, "correct": "B", "explanation": "'Abinci' means Food." },
  { "id": 16, "text": "Wane ne mijin 'Uwa'?", "options": { "A": "Kawu", "B": "Yaya", "C": "Uba", "D": "Kaka" }, "correct": "C", "explanation": "The husband of 'Mother' (Uwa) is 'Father' (Uba)." },
  { "id": 17, "text": "Mene ne 'Makaranta'?", "options": { "A": "Market", "B": "School", "C": "Mosque", "D": "Hospital" }, "correct": "B", "explanation": "'Makaranta' is School." },
  { "id": 18, "text": "Wane ne marubucin littafin 'Magana Jari Ce'?", "options": { "A": "Abubakar Imam", "B": "Aminu Kano", "C": "Cyprian Ekwensi", "D": "Chinua Achebe" }, "correct": "A", "explanation": "Abubakar Imam authored this famous Hausa book." },
  { "id": 19, "text": "Me ake nufi da 'Kujera'?", "options": { "A": "Table", "B": "Chair", "C": "Bed", "D": "Door" }, "correct": "B", "explanation": "'Kujera' translates to Chair." },
  { "id": 20, "text": "Wane irin abinci ne 'Tuwo'?", "options": { "A": "Liquid", "B": "Solid", "C": "Fruit", "D": "Vegetable" }, "correct": "B", "explanation": "Tuwo is a solid swallow food." },
  { "id": 21, "text": "Mene ne 'Baki'?", "options": { "A": "Mouth", "B": "Leg", "C": "Hand", "D": "Ear" }, "correct": "A", "explanation": "'Baki' means Mouth." },
  { "id": 22, "text": "Yaya ake cewa 'Thank you' da Hausa?", "options": { "A": "Sannu", "B": "Nagode", "C": "Yaya dai", "D": "Ina gajiya" }, "correct": "B", "explanation": "'Nagode' means Thank you." },
  { "id": 23, "text": "Mene ne jam'in 'Gida'?", "options": { "A": "Gidaje", "B": "Gidawa", "C": "Gidanu", "D": "Gidashi" }, "correct": "A", "explanation": "Plural of 'Gida' (House) is 'Gidaje'." },
  { "id": 24, "text": "Wane launi ne 'Baki'?", "options": { "A": "White", "B": "Black", "C": "Green", "D": "Yellow" }, "correct": "B", "explanation": "'Baki' (tonal diff from Mouth) means Black." },
  { "id": 25, "text": "Mene ne 'Takalmi'?", "options": { "A": "Shirt", "B": "Shoe", "C": "Cap", "D": "Trouser" }, "correct": "B", "explanation": "'Takalmi' means Shoe." },
  { "id": 26, "text": "Wane ne Allah?", "options": { "A": "Manzo", "B": "Mahalicci", "C": "Malami", "D": "Sarki" }, "correct": "B", "explanation": "Allah is the Creator (Mahalicci)." },
  { "id": 27, "text": "Karin magana: 'Kowa ya ci zomo, ya ci ______.'", "options": { "A": "Gudu", "B": "Dadi", "C": "Karya", "D": "Wahala" }, "correct": "A", "explanation": "Whoever eats a hare, eats speed (Must work hard)." },
  { "id": 28, "text": "Mene ne 'Rana'?", "options": { "A": "Moon", "B": "Sun", "C": "Star", "D": "Sky" }, "correct": "B", "explanation": "'Rana' means Sun." },
  { "id": 29, "text": "Wane gari ne cibiyar kasuwanci a Arewa?", "options": { "A": "Kaduna", "B": "Sokoto", "C": "Kano", "D": "Bauchi" }, "correct": "C", "explanation": "Kano is the commercial center of the North." },
  { "id": 30, "text": "Yaya ake cewa 'One' da Hausa?", "options": { "A": "Daya", "B": "Biyu", "C": "Uku", "D": "Hudu" }, "correct": "A", "explanation": "'Daya' is One." },
  { "id": 31, "text": "Mene ne 'Kifi'?", "options": { "A": "Bird", "B": "Fish", "C": "Snake", "D": "Goat" }, "correct": "B", "explanation": "'Kifi' means Fish." },
  { "id": 32, "text": "Wane ne ya rubuta 'Ruwan Bagaja'?", "options": { "A": "Abubakar Imam", "B": "Bello Kagara", "C": "Sa'adu Zungur", "D": "Aminu Kano" }, "correct": "A", "explanation": "Dr. Abubakar Imam." },
  { "id": 33, "text": "Mene ne 'Hannu'?", "options": { "A": "Head", "B": "Hand", "C": "Leg", "D": "Stomach" }, "correct": "B", "explanation": "'Hannu' means Hand." },
  { "id": 34, "text": "Wane ne 'Kaka'?", "options": { "A": "Father", "B": "Grandparent", "C": "Uncle", "D": "Brother" }, "correct": "B", "explanation": "'Kaka' is Grandfather or Grandmother." },
  { "id": 35, "text": "Mene ne 'Kasuwa'?", "options": { "A": "School", "B": "Market", "C": "Hospital", "D": "Farm" }, "correct": "B", "explanation": "'Kasuwa' is Market." },
  { "id": 36, "text": "Yaya ake cewa 'Welcome'?", "options": { "A": "Sannu da zuwa", "B": "Sai an jima", "C": "Ina wuni", "D": "Ina kwana" }, "correct": "A", "explanation": "'Sannu da zuwa' means Welcome." },
  { "id": 37, "text": "Mene ne 'Zuciya'?", "options": { "A": "Head", "B": "Heart", "C": "Liver", "D": "Kidney" }, "correct": "B", "explanation": "'Zuciya' means Heart." },
  { "id": 38, "text": "Wane ne 'Malami'?", "options": { "A": "Student", "B": "Teacher", "C": "Doctor", "D": "Driver" }, "correct": "B", "explanation": "'Malami' is a Teacher/Scholar." },
  { "id": 39, "text": "Mene ne 'Gona'?", "options": { "A": "House", "B": "Farm", "C": "School", "D": "Market" }, "correct": "B", "explanation": "'Gona' means Farm." },
  { "id": 40, "text": "Yaya ake cewa 'Boy' da Hausa?", "options": { "A": "Yarinya", "B": "Yaro", "C": "Tsoho", "D": "Samari" }, "correct": "B", "explanation": "'Yaro' means Boy." },
  { "id": 41, "text": "Mene ne 'Kaza'?", "options": { "A": "Goat", "B": "Hen/Chicken", "C": "Cow", "D": "Sheep" }, "correct": "B", "explanation": "'Kaza' is a Chicken/Hen." },
  { "id": 42, "text": "Karin magana: 'Aiki da ______ ya fi aiki da sani.'", "options": { "A": "Hankali", "B": "Gamu", "C": "Karfi", "D": "Kudi" }, "correct": "B", "explanation": "'Aiki da gamu...' (Experience is better than knowledge)." },
  { "id": 43, "text": "Mene ne 'Ido'?", "options": { "A": "Nose", "B": "Eye", "C": "Ear", "D": "Mouth" }, "correct": "B", "explanation": "'Ido' means Eye." },
  { "id": 44, "text": "Wane ne shugaban kasa?", "options": { "A": "Governor", "B": "President", "C": "Senator", "D": "Chairman" }, "correct": "B", "explanation": "'Shugaban kasa' is the President." },
  { "id": 45, "text": "Mene ne 'Wata'?", "options": { "A": "Sun", "B": "Moon/Month", "C": "Star", "D": "Sky" }, "correct": "B", "explanation": "'Wata' can mean Moon or Month." },
  { "id": 46, "text": "Yaya ake cewa 'Come' da Hausa?", "options": { "A": "Je", "B": "Zo", "C": "Tsaya", "D": "Zauna" }, "correct": "B", "explanation": "'Zo' means Come." },
  { "id": 47, "text": "Mene ne 'Littafi'?", "options": { "A": "Pen", "B": "Book", "C": "Pencil", "D": "Bag" }, "correct": "B", "explanation": "'Littafi' means Book." },
  { "id": 48, "text": "Wane launi ne 'Ja'?", "options": { "A": "Blue", "B": "Red", "C": "Green", "D": "Black" }, "correct": "B", "explanation": "'Ja' means Red." },
  { "id": 49, "text": "Mene ne 'Sallah'?", "options": { "A": "Prayer", "B": "Fasting", "C": "Giving", "D": "Reading" }, "correct": "A", "explanation": "'Sallah' refers to Prayer (Islamic)." },
  { "id": 50, "text": "Wane ne 'Kanwa'?", "options": { "A": "Older sister", "B": "Younger sister", "C": "Aunt", "D": "Mother" }, "correct": "B", "explanation": "'Kanwa' is Younger Sister." },
  { "id": 51, "text": "Mene ne 'Kudi'?", "options": { "A": "Food", "B": "Money", "C": "Clothes", "D": "Car" }, "correct": "B", "explanation": "'Kudi' means Money." },
  { "id": 52, "text": "Yaya ake cewa 'Sit down'?", "options": { "A": "Tashi", "B": "Zauna", "C": "Fita", "D": "Shiga" }, "correct": "B", "explanation": "'Zauna' means Sit." },
  { "id": 53, "text": "Mene ne 'Nama'?", "options": { "A": "Fish", "B": "Meat", "C": "Bread", "D": "Rice" }, "correct": "B", "explanation": "'Nama' means Meat." },
  { "id": 54, "text": "Wane ne 'Aboki'?", "options": { "A": "Enemy", "B": "Friend", "C": "Brother", "D": "Father" }, "correct": "B", "explanation": "'Aboki' means Friend." },
  { "id": 55, "text": "Mene ne 'Doki'?", "options": { "A": "Donkey", "B": "Horse", "C": "Camel", "D": "Cow" }, "correct": "B", "explanation": "'Doki' means Horse." },
  { "id": 56, "text": "Yaya ake cewa 'Go'?", "options": { "A": "Zo", "B": "Je", "C": "Dawo", "D": "Tsaya" }, "correct": "B", "explanation": "'Je' means Go." },
  { "id": 57, "text": "Mene ne 'Hula'?", "options": { "A": "Shoe", "B": "Cap", "C": "Shirt", "D": "Gown" }, "correct": "B", "explanation": "'Hula' means Cap." },
  { "id": 58, "text": "Wane ne 'Sarki'?", "options": { "A": "Slave", "B": "King/Emir", "C": "Servant", "D": "Messenger" }, "correct": "B", "explanation": "'Sarki' means King or Emir." },
  { "id": 59, "text": "Mene ne 'Riga'?", "options": { "A": "Trouser", "B": "Shirt/Gown", "C": "Cap", "D": "Shoe" }, "correct": "B", "explanation": "'Riga' means Shirt or Gown." },
  { "id": 60, "text": "Yaya ake cewa 'Sorry'?", "options": { "A": "Sannu", "B": "Yi hakuri", "C": "Na gode", "D": "Lafiya" }, "correct": "B", "explanation": "'Yi hakuri' means I'm sorry / Be patient." },
  { "id": 61, "text": "Mene ne 'Lemo'?", "options": { "A": "Mango", "B": "Orange", "C": "Banana", "D": "Apple" }, "correct": "B", "explanation": "'Lemo' usually refers to Orange or citrus." },
  { "id": 62, "text": "Wane ne 'Yaya'?", "options": { "A": "Younger sibling", "B": "Older sibling", "C": "Parent", "D": "Child" }, "correct": "B", "explanation": "'Yaya' refers to an older sibling." },
  { "id": 63, "text": "Mene ne 'Gari'?", "options": { "A": "Food", "B": "Town/Flour", "C": "Water", "D": "Fire" }, "correct": "B", "explanation": "'Gari' can mean Town or Cassava flour depending on tone." },
  { "id": 64, "text": "Yaya ake cewa 'Water'?", "options": { "A": "Wuta", "B": "Ruwa", "C": "Iska", "D": "Kasa" }, "correct": "B", "explanation": "'Ruwa' is Water." },
