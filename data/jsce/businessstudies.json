[
  { "id": 1, "text": "The place where clerical work is done is called an ______.", "options": { "A": "Office", "B": "Market", "C": "School", "D": "Church" }, "correct": "A", "explanation": "An office is a room or building used for commercial or professional work." },
  { "id": 2, "text": "Which department handles staff employment?", "options": { "A": "Sales", "B": "Production", "C": "Personnel/HR", "D": "Accounts" }, "correct": "C", "explanation": "Human Resources (Personnel) manages hiring and employee welfare." },
  { "id": 3, "text": "The fastest means of transport is ______.", "options": { "A": "Road", "B": "Water", "C": "Air", "D": "Rail" }, "correct": "C", "explanation": "Air transport is the quickest method for long distances." },
  { "id": 4, "text": "Which document is used to record daily sales?", "options": { "A": "Receipt", "B": "Invoice", "C": "Sales Journal", "D": "Cash Book" }, "correct": "C", "explanation": "Sales Journal (Day Book) records credit sales." },
  { "id": 5, "text": "Petty cash book records ______.", "options": { "A": "Large expenses", "B": "Minor expenses", "C": "Salaries", "D": "Capital" }, "correct": "B", "explanation": "It tracks small, day-to-day expenditures." },
  { "id": 6, "text": "The reception office is usually located at the ______.", "options": { "A": "Back of the building", "B": "Entrance", "C": "Top floor", "D": "Basement" }, "correct": "B", "explanation": "It is the first point of contact for visitors." },
  { "id": 7, "text": "Which of these is an aid to trade?", "options": { "A": "Fishing", "B": "Banking", "C": "Farming", "D": "Mining" }, "correct": "B", "explanation": "Banking provides financial services to support trade." },
  { "id": 8, "text": "A ledger is a book of ______.", "options": { "A": "Original entry", "B": "Final entry", "C": "Rough work", "D": "Invoices" }, "correct": "B", "explanation": "Ledgers contain the final permanent records." },
  { "id": 9, "text": "Communication is the exchange of ______.", "options": { "A": "Goods", "B": "Information", "C": "Money", "D": "Gifts" }, "correct": "B", "explanation": "Sending and receiving messages/ideas." },
  { "id": 10, "text": "Which of these is NOT a function of an office?", "options": { "A": "Receiving information", "B": "Processing information", "C": "Manufacturing goods", "D": "Storing information" }, "correct": "C", "explanation": "Manufacturing happens in a factory, not an office." },
  { "id": 11, "text": "The reward for labor is ______.", "options": { "A": "Profit", "B": "Rent", "C": "Wages/Salaries", "D": "Interest" }, "correct": "C", "explanation": "Workers earn wages or salaries." },
  { "id": 12, "text": "Sole proprietorship is owned by ______.", "options": { "A": "Two people", "B": "One person", "C": "Government", "D": "Shareholders" }, "correct": "B", "explanation": "Sole = Single owner." },
  { "id": 13, "text": "Capital owned by a business is called ______.", "options": { "A": "Asset", "B": "Liability", "C": "Equity", "D": "Loan" }, "correct": "C", "explanation": "Owner's equity or capital." },
  { "id": 14, "text": "Which machine is used for shredding documents?", "options": { "A": "Photocopier", "B": "Shredder", "C": "Scanner", "D": "Printer" }, "correct": "B", "explanation": "Shredders destroy sensitive paper documents." },
  { "id": 15, "text": "The person who buys goods from the producer and sells to retailers is a ______.", "options": { "A": "Consumer", "B": "Wholesaler", "C": "Agent", "D": "Manufacturer" }, "correct": "B", "explanation": "Wholesalers buy in bulk and sell in smaller quantities." },
  { "id": 16, "text": "A cheque that is not paid by the bank is called ______.", "options": { "A": "Valid cheque", "B": "Dishonored cheque", "C": "Open cheque", "D": "Crossed cheque" }, "correct": "B", "explanation": "Dishonored due to insufficient funds or errors." },
  { "id": 17, "text": "Home row keys in typewriting include ______.", "options": { "A": "QWERTY", "B": "ASDF", "C": "ZXCV", "D": "1234" }, "correct": "B", "explanation": "ASDF JKL; are the home row keys." },
  { "id": 18, "text": "Which document shows the details of goods sold?", "options": { "A": "Receipt", "B": "Invoice", "C": "Cheque", "D": "Order" }, "correct": "B", "explanation": "An invoice lists items and prices for payment." },
  { "id": 19, "text": "Which of these is an extractive industry?", "options": { "A": "Banking", "B": "Mining", "C": "Teaching", "D": "Constructing" }, "correct": "B", "explanation": "Extracting raw materials from the earth." },
  { "id": 20, "text": "Honesty in business leads to ______.", "options": { "A": "Loss", "B": "Goodwill and trust", "C": "Bankruptcy", "D": "Confusion" }, "correct": "B", "explanation": "Ethical behavior builds a good reputation." },
  { "id": 21, "text": "The abbreviation 'Ltd' stands for ______.", "options": { "A": "Limited", "B": "Listed", "C": "Licensed", "D": "Liquidated" }, "correct": "A", "explanation": "Limited Liability Company." },
  { "id": 22, "text": "Import trade means ______.", "options": { "A": "Selling goods abroad", "B": "Buying goods from abroad", "C": "Buying locally", "D": "Exchanging goods" }, "correct": "B", "explanation": "Bringing goods IN to the country." },
  { "id": 23, "text": "The main objective of a business is to ______.", "options": { "A": "Pay tax", "B": "Make profit", "C": "Employ people", "D": "Build houses" }, "correct": "B", "explanation": "Profit maximization is the primary goal." },
  { "id": 24, "text": "Which of these is a source of capital?", "options": { "A": "Spending", "B": "Personal savings", "C": "Stealing", "D": "Giving gifts" }, "correct": "B", "explanation": "Savings are a common way to start a business." },
  { "id": 25, "text": "Insurance protects against ______.", "options": { "A": "Profit", "B": "Loss/Risk", "C": "Tax", "D": "Sales" }, "correct": "B", "explanation": "It provides financial protection against loss." },
  { "id": 26, "text": "A market is a place where ______.", "options": { "A": "People sleep", "B": "Buying and selling takes place", "C": "Goods are manufactured", "D": "Money is printed" }, "correct": "B", "explanation": "Venue for exchange of goods/services." },
  { "id": 27, "text": "The right hand home row keys are ______.", "options": { "A": "ASDF", "B": "JKL;", "C": "QWER", "D": "ZXCV" }, "correct": "B", "explanation": "Fingers rest on J, K, L, ;." },
  { "id": 28, "text": "Which of these is a liability?", "options": { "A": "Cash", "B": "Creditors", "C": "Stock", "D": "Furniture" }, "correct": "B", "explanation": "Money owed to others (Creditors) is a liability." },
  { "id": 29, "text": "Double entry principle states: For every debit entry, there must be a ______.", "options": { "A": "Debit entry", "B": "Credit entry", "C": "Double entry", "D": "Single entry" }, "correct": "B", "explanation": "Corresponding credit entry." },
  { "id": 30, "text": "Advertising is meant to ______.", "options": { "A": "Hide goods", "B": "Create awareness", "C": "Damage goods", "D": "Increase cost only" }, "correct": "B", "explanation": "Promotes products to potential buyers." },
  { "id": 31, "text": "Which of these is intangible?", "options": { "A": "Car", "B": "Service", "C": "Table", "D": "Computer" }, "correct": "B", "explanation": "Services cannot be touched." },
  { "id": 32, "text": "A mail coming into an organization is ______.", "options": { "A": "Outward mail", "B": "Incoming mail", "C": "Electronic mail", "D": "Dispatch" }, "correct": "B", "explanation": "Mail received by the firm." },
  { "id": 33, "text": "The ledger account for cash transactions is ______.", "options": { "A": "Sales account", "B": "Cash account/book", "C": "Purchases account", "D": "Capital account" }, "correct": "B", "explanation": "Records cash receipts and payments." },
  { "id": 34, "text": "Which of these is an asset?", "options": { "A": "Loan", "B": "Building", "C": "Overdraft", "D": "Creditor" }, "correct": "B", "explanation": "Property owned by the business." },
  { "id": 35, "text": "Commerce includes trade and ______.", "options": { "A": "Production", "B": "Aids to trade", "C": "Manufacturing", "D": "Farming" }, "correct": "B", "explanation": "Commerce = Trade + Aids to Trade." },
  { "id": 36, "text": "A person who uses a typewriter is a ______.", "options": { "A": "Manager", "B": "Typist", "C": "Cleaner", "D": "Driver" }, "correct": "B", "explanation": "Professional typist." },
  { "id": 37, "text": "Which document acknowledges payment?", "options": { "A": "Invoice", "B": "Receipt", "C": "Order", "D": "Quotation" }, "correct": "B", "explanation": "Proof of payment." },
  { "id": 38, "text": "The head of a school's administrative staff is the ______.", "options": { "A": "Teacher", "B": "Principal", "C": "Prefect", "D": "Cleaner" }, "correct": "B", "explanation": "Principal/Headmaster manages the school." },
  { "id": 39, "text": "Which bank issues currency?", "options": { "A": "Commercial Bank", "B": "Central Bank", "C": "Merchant Bank", "D": "Mortgage Bank" }, "correct": "B", "explanation": "CBN has the sole authority to issue Naira." },
  { "id": 40, "text": "Entrepreneurship involves ______.", "options": { "A": "Avoiding risks", "B": "Taking risks to set up business", "C": "Working for government", "D": "Saving money only" }, "correct": "B", "explanation": "Creating and managing a business venture." },
  { "id": 41, "text": "Which department handles buying of goods?", "options": { "A": "Sales", "B": "Purchasing", "C": "Accounts", "D": "Transport" }, "correct": "B", "explanation": "Procurement department." },
  { "id": 42, "text": "Transparency in business means ______.", "options": { "A": "Secrecy", "B": "Openness", "C": "Corruption", "D": "Complexity" }, "correct": "B", "explanation": "Being clear and accountable." },
  { "id": 43, "text": "Which office machine replicates documents?", "options": { "A": "Perforator", "B": "Photocopier", "C": "Stapler", "D": "Calculator" }, "correct": "B", "explanation": "Makes copies." },
  { "id": 44, "text": "A budget is a plan of ______.", "options": { "A": "Past events", "B": "Income and expenditure", "C": "Games", "D": "Travel" }, "correct": "B", "explanation": "Financial plan." },
  { "id": 45, "text": "Which of these is a factor of production?", "options": { "A": "Money", "B": "Land", "C": "Bank", "D": "Market" }, "correct": "B", "explanation": "Factors: Land, Labor, Capital, Entrepreneur." },
  { "id": 46, "text": "Net pay is salary after ______.", "options": { "A": "Bonuses", "B": "Deductions", "C": "Overtime", "D": "Promotion" }, "correct": "B", "explanation": "Take-home pay." },
  { "id": 47, "text": "A partnership has a minimum of ______ people.", "options": { "A": "1", "B": "2", "C": "20", "D": "50" }, "correct": "B", "explanation": "At least two partners." },
  { "id": 48, "text": "Which of these is a commercial bank?", "options": { "A": "CBN", "B": "First Bank", "C": "World Bank", "D": "IMF" }, "correct": "B", "explanation": "First Bank is a retail/commercial bank." },
  { "id": 49, "text": "The main ledger is called ______.", "options": { "A": "General Ledger", "B": "Private Ledger", "C": "Sales Ledger", "D": "Cash Ledger" }, "correct": "A", "explanation": "Contains all accounts." },
  { "id": 50, "text": "Filing is the method of ______.", "options": { "A": "Throwing papers away", "B": "Arranging and storing documents", "C": "Burning papers", "D": "Copying papers" }, "correct": "B", "explanation": "Organizing records for retrieval." },
  { "id": 51, "text": "Which of these is an example of indirect service?", "options": { "A": "Teacher", "B": "Police/Civil Servant", "C": "Hairdresser", "D": "Doctor" }, "correct": "B", "explanation": "Paid by government taxes, serves public generally." },
  { "id": 52, "text": "Which transport is best for bulky goods locally?", "options": { "A": "Air", "B": "Rail", "C": "Pipeline", "D": "Road" }, "correct": "B", "explanation": "Rail is efficient for heavy bulk." },
  { "id": 53, "text": "A trial balance checks ______.", "options": { "A": "Profit", "B": "Arithmetical accuracy", "C": "Fraud", "D": "Stock" }, "correct": "B", "explanation": "Ensures debits equal credits." },
  { "id": 54, "text": "When supply exceeds demand, price ______.", "options": { "A": "Rises", "B": "Falls", "C": "Stays same", "D": "Doubles" }, "correct": "B", "explanation": "Surplus drives prices down." },
  { "id": 55, "text": "The space bar is used to ______.", "options": { "A": "Delete", "B": "Create space between words", "C": "Go to next line", "D": "Capitalize" }, "correct": "B", "explanation": "Inserts a space character." },
  { "id": 56, "text": "Which of these is a public corporation?", "options": { "A": "Dangote Group", "B": "NNPC", "C": "Shoprite", "D": "Glo" }, "correct": "B", "explanation": "State-owned enterprise." },
  { "id": 57, "text": "Punctuality helps to ______.", "options": { "A": "Waste time", "B": "Increase productivity", "C": "Cause delay", "D": "Reduce profit" }, "correct": "B", "explanation": "Being on time improves efficiency." },
  { "id": 58, "text": "A bill of lading is used in ______.", "options": { "A": "Road transport", "B": "Sea transport", "C": "Air transport", "D": "Rail transport" }, "correct": "B", "explanation": "Document for shipping cargo." },
  { "id": 59, "text": "Which account is for savings?", "options": { "A": "Current account", "B": "Savings account", "C": "Fixed deposit", "D": "Loan account" }, "correct": "B", "explanation": "Designed for accumulating funds." },
  { "id": 60, "text": "The reward for land is ______.", "options": { "A": "Wages", "B": "Rent", "C": "Interest", "D": "Profit" }, "correct": "B", "explanation": "Payment for use of land." },
  { "id": 61, "text": "Division of labor leads to ______.", "options": { "A": "Slowness", "B": "Specialization", "C": "Confusion", "D": "Waste" }, "correct": "B", "explanation": "Focusing on specific tasks." },
  { "id": 62, "text": "Which of these is a source of document?", "options": { "A": "Receipt", "B": "Table", "C": "Chair", "D": "Pen" }, "correct": "A", "explanation": "Provides data for accounting." },
  { "id": 63, "text": "Warehouse is for ______.", "options": { "A": "Selling", "B": "Storage", "C": "Production", "D": "Disposal" }, "correct": "B", "explanation": "Storing goods before sale." },
  { "id": 64, "text": "Which key capitalizes a single letter?", "options": { "A": "Caps Lock", "B": "Shift", "C": "Enter", "D": "Tab" }, "correct": "B", "explanation": "Shift + Letter." },
  { "id": 65, "text": "Barter system is ______.", "options": { "A": "Trade with money", "B": "Exchange of goods for goods", "C": "Online trade", "D": "Importing" }, "correct": "B", "explanation": "Trade without currency." },
  { "id": 66, "text": "Assets - Liabilities = ______.", "options": { "A": "Profit", "B": "Capital", "C": "Sales", "D": "Expenses" }, "correct": "B", "explanation": "Accounting equation." },
  { "id": 67, "text": "The final user of a product is ______.", "options": { "A": "Retailer", "B": "Consumer", "C": "Wholesaler", "D": "Agent" }, "correct": "B", "explanation": "End-user." },
  { "id": 68, "text": "Tourism generates ______.", "options": { "A": "Pollution", "B": "Revenue/Foreign exchange", "C": "Crime", "D": "Poverty" }, "correct": "B", "explanation": "Economic benefit." },
  { "id": 69, "text": "Internet helps business to ______.", "options": { "A": "Close down", "B": "Reach global market", "C": "Reduce sales", "D": "Increase paper work" }, "correct": "B", "explanation": "Global connectivity." },
  { "id": 70, "text": "Ethics involves ______.", "options": { "A": "Making money at all costs", "B": "Moral principles", "C": "Breaking laws", "D": "Cheating" }, "correct": "B", "explanation": "Right vs Wrong conduct." }
]