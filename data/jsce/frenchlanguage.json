  { "id": 66, "text": "Translate 'I don't know'.", "options": { "A": "Je sais", "B": "Je ne sais pas", "C": "Je ne suis pas", "D": "Je n'ai pas" }, "correct": "B", "explanation": "Negation 'ne...pas'." },
  { "id": 67, "text": "'Le soir' means ______.", "options": { "A": "Morning", "B": "Evening", "C": "Afternoon", "D": "Night" }, "correct": "B", "explanation": "Times of day." },
  { "id": 68, "text": "Quel âge as-tu ?", "options": { "A": "Je suis Paul", "B": "J'ai 12 ans", "C": "Il est 12h", "D": "Ça va bien" }, "correct": "B", "explanation": "Asking for age." },
  { "id": 69, "text": "'L'avion' means ______.", "options": { "A": "Train", "B": "Airplane", "C": "Bus", "D": "Boat" }, "correct": "B", "explanation": "Transport vocabulary." },
