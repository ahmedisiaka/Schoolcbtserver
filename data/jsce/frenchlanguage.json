[
  { "id": 1, "text": "Comment t'appelles-tu ?", "options": { "A": "J'habite à Lagos", "B": "Je m'appelle Paul", "C": "J'ai dix ans", "D": "Je suis Nigerian" }, "correct": "B", "explanation": "The question asks for your name. 'Je m'appelle Paul' means 'My name is Paul'." },
  { "id": 2, "text": "Quel jour sommes-nous ?", "options": { "A": "Il est midi", "B": "C'est fini", "C": "Nous sommes lundi", "D": "Je vais bien" }, "correct": "C", "explanation": "The question asks for the day. 'Nous sommes lundi' means 'It is Monday'." },
  { "id": 3, "text": "Le frère de mon père est mon ______.", "options": { "A": "Frère", "B": "Oncle", "C": "Cousin", "D": "Grand-père" }, "correct": "B", "explanation": "Father's brother is an uncle (Oncle)." },
  { "id": 4, "text": "Complete the sentence: Je ______ au marché.", "options": { "A": "va", "B": "vas", "C": "vais", "D": "allez" }, "correct": "C", "explanation": "Conjugation of 'aller' (to go) for 'Je' is 'vais'." },
  { "id": 5, "text": "Un, deux, trois, quatre, ______.", "options": { "A": "Six", "B": "Sept", "C": "Cinq", "D": "Huit" }, "correct": "C", "explanation": "Counting: 1, 2, 3, 4, 5 (Cinq)." },
  { "id": 6, "text": "Quelle heure est-il ?", "options": { "A": "Il est petit", "B": "Il est médecin", "C": "Il est huit heures", "D": "Il est gentil" }, "correct": "C", "explanation": "Asking for time. 'Il est huit heures' = It is 8 o'clock." },
  { "id": 7, "text": "Translate 'Good morning' to French.", "options": { "A": "Bonsoir", "B": "Bonne nuit", "C": "Bonjour", "D": "Salut" }, "correct": "C", "explanation": "'Bonjour' is used for Good morning/Good day." },
  { "id": 8, "text": "J'ai mal à la tête. Where is the pain?", "options": { "A": "Leg", "B": "Stomach", "C": "Head", "D": "Hand" }, "correct": "C", "explanation": "'Tête' means Head." },
  { "id": 9, "text": "The feminine of 'Garçon' is ______.", "options": { "A": "Homme", "B": "Fille", "C": "Dame", "D": "Mère" }, "correct": "B", "explanation": "Boy (Garçon) vs Girl (Fille)." },
  { "id": 10, "text": "Complete: Nous ______ des étudiants.", "options": { "A": "suis", "B": "sont", "C": "sommes", "D": "est" }, "correct": "C", "explanation": "Verb 'être' (to be) for 'Nous' is 'sommes'." },
  { "id": 11, "text": "Comment ça va ?", "options": { "A": "J'ai faim", "B": "Ça va bien, merci", "C": "Au revoir", "D": "Bon appétit" }, "correct": "B", "explanation": "How are you? -> I am fine, thank you." },
  { "id": 12, "text": "Le stylo est ______ la table.", "options": { "A": "sur", "B": "dans", "C": "en", "D": "pour" }, "correct": "A", "explanation": "'Sur' means 'on'." },
  { "id": 13, "text": "What is 'La voiture' in English?", "options": { "A": "The house", "B": "The car", "C": "The bike", "D": "The plane" }, "correct": "B", "explanation": "Voiture = Car." },
  { "id": 14, "text": "Il ______ une pomme.", "options": { "A": "mange", "B": "manges", "C": "mangeons", "D": "manger" }, "correct": "A", "explanation": "Verb 'manger' (to eat) for 'Il' is 'mange'." },
  { "id": 15, "text": "The color 'Rouge' is ______.", "options": { "A": "Blue", "B": "Green", "C": "Red", "D": "Yellow" }, "correct": "C", "explanation": "Rouge = Red." },
  { "id": 16, "text": "J'ai soif. I want to ______.", "options": { "A": "Eat", "B": "Sleep", "C": "Drink", "D": "Run" }, "correct": "C", "explanation": "'J'ai soif' means 'I am thirsty'." },
  { "id": 17, "text": "Opposite of 'Grand' is ______.", "options": { "A": "Gros", "B": "Petit", "C": "Long", "D": "Haut" }, "correct": "B", "explanation": "Big/Tall (Grand) vs Small (Petit)." },
  { "id": 18, "text": "Translate 'Thank you very much'.", "options": { "A": "S'il vous plaît", "B": "Merci beaucoup", "C": "Pardon", "D": "De rien" }, "correct": "B", "explanation": "Merci beaucoup." },
  { "id": 19, "text": "Le père de ma mère est mon ______.", "options": { "A": "Père", "B": "Oncle", "C": "Grand-père", "D": "Frère" }, "correct": "C", "explanation": "Mother's father is Grandfather." },
  { "id": 20, "text": "Choose the correct article: ______ école.", "options": { "A": "Le", "B": "La", "C": "L'", "D": "Les" }, "correct": "C", "explanation": "Use L' before a vowel sound (École)." },
  { "id": 21, "text": "Quelle est ta nationalité ?", "options": { "A": "Je suis grand", "B": "Je suis nigérian", "C": "Je suis étudiant", "D": "Je suis malade" }, "correct": "B", "explanation": "Nationality question." },
  { "id": 22, "text": "The month after 'Janvier' is ______.", "options": { "A": "Mars", "B": "Février", "C": "Avril", "D": "Mai" }, "correct": "B", "explanation": "January, February (Février)." },
  { "id": 23, "text": "Complete: Ils ______ le football.", "options": { "A": "aime", "B": "aimes", "C": "aiment", "D": "aimons" }, "correct": "C", "explanation": "Verb 'aimer' for 'Ils' ends in -ent." },
  { "id": 24, "text": "'La chemise' means ______.", "options": { "A": "The skirt", "B": "The shirt", "C": "The shoe", "D": "The trousers" }, "correct": "B", "explanation": "Clothing vocabulary." },
  { "id": 25, "text": "Il fait chaud. The weather is ______.", "options": { "A": "Cold", "B": "Hot", "C": "Rainy", "D": "Windy" }, "correct": "B", "explanation": "Chaud = Hot." },
  { "id": 26, "text": "Where do you buy bread? À la ______.", "options": { "A": "Pharmacie", "B": "Boulangerie", "C": "Bibliothèque", "D": "Poste" }, "correct": "B", "explanation": "Bakery = Boulangerie." },
  { "id": 27, "text": "Plural of 'Le livre' is ______.", "options": { "A": "La livre", "B": "Les livres", "C": "L'livres", "D": "Le livres" }, "correct": "B", "explanation": "Article 'Les' and add 's' to noun." },
  { "id": 28, "text": "Je vais ______ école.", "options": { "A": "au", "B": "à la", "C": "à l'", "D": "aux" }, "correct": "C", "explanation": "À l' because école starts with a vowel." },
  { "id": 29, "text": "'Quarante' is number ______.", "options": { "A": "14", "B": "40", "C": "4", "D": "44" }, "correct": "B", "explanation": "Quarante = 40." },
