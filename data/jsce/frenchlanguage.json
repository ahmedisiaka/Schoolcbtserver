  { "id": 31, "text": "Le nez is part of the ______.", "options": { "A": "Main", "B": "Tête", "C": "Jambe", "D": "Bras" }, "correct": "B", "explanation": "Nose (nez) is on the Head (tête)." },
  { "id": 32, "text": "Mon ami est gentil. 'Gentil' means ______.", "options": { "A": "Mean", "B": "Kind", "C": "Tall", "D": "Short" }, "correct": "B", "explanation": "Gentil = Kind/Nice." },
  { "id": 33, "text": "Complete: Tu ______ quel âge ?", "options": { "A": "ai", "B": "as", "C": "a", "D": "avons" }, "correct": "B", "explanation": "Verb 'avoir' (to have) for 'Tu' is 'as'." },
  { "id": 34, "text": "C'est un chien. 'Chien' is a ______.", "options": { "A": "Cat", "B": "Dog", "C": "Bird", "D": "Fish" }, "correct": "B", "explanation": "Chien = Dog." },
  { "id": 35, "text": "The day before 'Dimanche' is ______.", "options": { "A": "Lundi", "B": "Samedi", "C": "Vendredi", "D": "Mardi" }, "correct": "B", "explanation": "Saturday (Samedi) comes before Sunday." },
  { "id": 36, "text": "'Le tableau' is ______.", "options": { "A": "The table", "B": "The blackboard", "C": "The chair", "D": "The pen" }, "correct": "B", "explanation": "Tableau = Board/Blackboard." },
  { "id": 37, "text": "Complete: ______ habitent à Abuja.", "options": { "A": "Il", "B": "Elles", "C": "Je", "D": "Tu" }, "correct": "B", "explanation": "Verb ends in -ent, so subject must be plural (Elles)." },
  { "id": 38, "text": "Translate 'I am hungry'.", "options": { "A": "J'ai soif", "B": "J'ai faim", "C": "J'ai peur", "D": "J'ai froid" }, "correct": "B", "explanation": "Avoir faim = To be hungry." },
  { "id": 39, "text": "The flag of France is ______.", "options": { "A": "Vert, Blanc, Rouge", "B": "Bleu, Blanc, Rouge", "C": "Noir, Jaune, Rouge", "D": "Vert, Blanc, Vert" }, "correct": "B", "explanation": "Blue, White, Red." },
  { "id": 40, "text": "Combien de jours dans une semaine ?", "options": { "A": "Cinq", "B": "Sept", "C": "Dix", "D": "Douze" }, "correct": "B", "explanation": "7 days in a week." },
  { "id": 41, "text": "'La fenêtre' means ______.", "options": { "A": "The door", "B": "The window", "C": "The wall", "D": "The floor" }, "correct": "B", "explanation": "Window." },
