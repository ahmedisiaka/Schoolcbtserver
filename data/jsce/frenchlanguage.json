  { "id": 43, "text": "Opposite of 'Noir' is ______.", "options": { "A": "Rouge", "B": "Blanc", "C": "Vert", "D": "Bleu" }, "correct": "B", "explanation": "Black (Noir) vs White (Blanc)." },
  { "id": 44, "text": "Je vais au lit. I am going to ______.", "options": { "A": "Work", "B": "Bed", "C": "School", "D": "Market" }, "correct": "B", "explanation": "Lit = Bed." },
  { "id": 45, "text": "Complete: C'est le livre ______ Paul.", "options": { "A": "de", "B": "à", "C": "pour", "D": "sur" }, "correct": "A", "explanation": "Possession: The book OF Paul (de Paul)." },
  { "id": 46, "text": "'Mardi' means ______.", "options": { "A": "Monday", "B": "Tuesday", "C": "Wednesday", "D": "Thursday" }, "correct": "B", "explanation": "Days of the week." },
  { "id": 47, "text": "Which is a fruit? 'La ______'.", "options": { "A": "Pomme", "B": "Pomme de terre", "C": "Voiture", "D": "Table" }, "correct": "A", "explanation": "Pomme = Apple." },
  { "id": 48, "text": "Translate 'My sister'.", "options": { "A": "Mon frère", "B": "Ma soeur", "C": "Ma mère", "D": "Mon père" }, "correct": "B", "explanation": "Ma soeur." },
  { "id": 49, "text": "Où est le chat ? 'Sous' la table.", "options": { "A": "On", "B": "Under", "C": "In", "D": "Behind" }, "correct": "B", "explanation": "Sous = Under." },
  { "id": 50, "text": "'Soixante' is ______.", "options": { "A": "50", "B": "60", "C": "70", "D": "80" }, "correct": "B", "explanation": "Soixante = 60." },
  { "id": 51, "text": "J'aime ______ (to swim).", "options": { "A": "danser", "B": "nager", "C": "chanter", "D": "courir" }, "correct": "B", "explanation": "Nager = to swim." },
  { "id": 52, "text": "Quelle est la capitale de la France ?", "options": { "A": "Lyon", "B": "Paris", "C": "Marseille", "D": "Bordeaux" }, "correct": "B", "explanation": "Paris is the capital." },
  { "id": 53, "text": "Il est 'triste'. He is ______.", "options": { "A": "Happy", "B": "Sad", "C": "Angry", "D": "Tired" }, "correct": "B", "explanation": "Triste = Sad." },
  { "id": 54, "text": "Complete: J'______ un stylo.", "options": { "A": "ai", "B": "as", "C": "a", "D": "ont" }, "correct": "A", "explanation": "Verb 'avoir' for 'Je' is 'ai' (J'ai)." },
  { "id": 55, "text": "'L'hiver' means ______.", "options": { "A": "Summer", "B": "Winter", "C": "Spring", "D": "Autumn" }, "correct": "B", "explanation": "Seasons vocabulary." },
