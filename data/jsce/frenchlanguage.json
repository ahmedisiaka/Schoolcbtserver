  { "id": 57, "text": "Le professeur ______ la leçon.", "options": { "A": "explique", "B": "expliques", "C": "expliquent", "D": "expliquons" }, "correct": "A", "explanation": "Subject 'Le professeur' (Il) takes 'explique'." },
  { "id": 58, "text": "'Les yeux' means ______.", "options": { "A": "Ears", "B": "Eyes", "C": "Nose", "D": "Mouth" }, "correct": "B", "explanation": "Body parts." },
  { "id": 59, "text": "Qu'est-ce que c'est ? C'est ______.", "options": { "A": "une gomme", "B": "un gomme", "C": "le gomme", "D": "gomme" }, "correct": "A", "explanation": "Gomme (Eraser) is feminine." },
  { "id": 60, "text": "12 + 3 = ______.", "options": { "A": "Treize", "B": "Quinze", "C": "Quatorze", "D": "Seize" }, "correct": "B", "explanation": "15 = Quinze." },
  { "id": 61, "text": "Comment dit-on 'Good night' ?", "options": { "A": "Bonjour", "B": "Bonsoir", "C": "Bonne nuit", "D": "Au revoir" }, "correct": "C", "explanation": "Bonne nuit." },
  { "id": 62, "text": "Il porte un pantalon ______ (blue).", "options": { "A": "bleu", "B": "bleue", "C": "bleus", "D": "bleues" }, "correct": "A", "explanation": "Pantalon is masculine singular, so 'bleu'." },
  { "id": 63, "text": "Le fils de ma tante est mon ______.", "options": { "A": "Frère", "B": "Cousin", "C": "Neveu", "D": "Oncle" }, "correct": "B", "explanation": "Aunt's son is Cousin." },
  { "id": 64, "text": "'La cuisine' is the ______.", "options": { "A": "Bedroom", "B": "Kitchen", "C": "Bathroom", "D": "Living room" }, "correct": "B", "explanation": "Room for cooking." },
