  { "id": 26, "text": "Solve \\( \\frac{x}{2} = 5 \\).", "options": { "A": "5", "B": "7", "C": "10", "D": "2.5" }, "correct": "C", "explanation": "Multiply both sides by 2: \\(x = 5 \\times 2 = 10\\)." },
