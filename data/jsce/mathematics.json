  { "id": 37, "text": "If \\( P = \\{1, 2, 3\\} \\) and \\( Q = \\{3, 4, 5\\} \\), find \\( P \\cap Q \\).", "options": { "A": "{1, 2}", "B": "{3}", "C": "{4, 5}", "D": "{1, 2, 3, 4, 5}" }, "correct": "B", "explanation": "Intersection means common elements. Only 3 is in both." },
