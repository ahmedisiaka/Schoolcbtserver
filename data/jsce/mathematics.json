  { "id": 30, "text": "Convert 25 base 10 to base 2.", "options": { "A": "11000", "B": "11001", "C": "10011", "D": "11100" }, "correct": "B", "explanation": "25 = 16 + 8 + 1 = \\(1(2^4) + 1(2^3) + 0(2^2) + 0(2^1) + 1(2^0) = 11001_2\\)." },
