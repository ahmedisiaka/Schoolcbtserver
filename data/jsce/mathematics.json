[
  { "id": 1, "text": "Express \\(3.04 \\times 10^{-4}\\) as a decimal number.", "options": { "A": "0.00304", "B": "0.000304", "C": "0.0304", "D": "30400" }, "correct": "B", "explanation": "\\(10^{-4}\\) means moving the decimal point 4 places to the left. 3.04 becomes 0.000304." },
  { "id": 2, "text": "Round 45.7891 to 2 decimal places.", "options": { "A": "45.78", "B": "45.79", "C": "45.80", "D": "46.00" }, "correct": "B", "explanation": "The 3rd decimal digit is 9 (greater than 5), so we round up the 2nd digit (8) to 9. Result is 45.79." },
  { "id": 3, "text": "Simplify \\( \\frac{2}{3} + \\frac{1}{4} \\).", "options": { "A": "11/12", "B": "3/7", "C": "8/12", "D": "1/2" }, "correct": "A", "explanation": "LCM of 3 and 4 is 12. \\(\\frac{8}{12} + \\frac{3}{12} = \\frac{11}{12}\\)." },
  { "id": 4, "text": "Find the L.C.M of 6, 8, and 12.", "options": { "A": "12", "B": "24", "C": "48", "D": "36" }, "correct": "B", "explanation": "Multiples of 12: 12, 24, 36... 24 is divisible by 6 and 8." },
  { "id": 5, "text": "Find the H.C.F of 18, 24, and 36.", "options": { "A": "3", "B": "6", "C": "9", "D": "12" }, "correct": "B", "explanation": "Factors of 18: 1,2,3,6,9,18. Factors of 24: 1,2,3,4,6... Factors of 36: 1,2,3,4,6... Common highest is 6." },
  { "id": 6, "text": "Express 1101 base 2 to base 10.", "options": { "A": "11", "B": "13", "C": "15", "D": "9" }, "correct": "B", "explanation": "\\(1(2^3) + 1(2^2) + 0(2^1) + 1(2^0) = 8 + 4 + 0 + 1 = 13\\)." },
  { "id": 7, "text": "Evaluate \\( \\sqrt{144} + \\sqrt{25} \\).", "options": { "A": "13", "B": "15", "C": "17", "D": "19" }, "correct": "C", "explanation": "\\(\\sqrt{144} = 12\\), \\(\\sqrt{25} = 5\\). \\(12 + 5 = 17\\)." },
  { "id": 8, "text": "Simplify \\( 2a + 3b - a + 4b \\).", "options": { "A": "a + 7b", "B": "3a + 7b", "C": "a - b", "D": "3a - b" }, "correct": "A", "explanation": "Group like terms: \\((2a - a) + (3b + 4b) = a + 7b\\)." },
  { "id": 9, "text": "Solve for \\(x\\): \\( 3x - 5 = 10 \\).", "options": { "A": "3", "B": "4", "C": "5", "D": "6" }, "correct": "C", "explanation": "\\(3x = 10 + 5 \\rightarrow 3x = 15 \\rightarrow x = 5\\)." },
  { "id": 10, "text": "If \\( a = 2 \\) and \\( b = 3 \\), evaluate \\( 2a + 3b \\).", "options": { "A": "10", "B": "12", "C": "13", "D": "15" }, "correct": "C", "explanation": "\\(2(2) + 3(3) = 4 + 9 = 13\\)." },
  { "id": 11, "text": "Calculate the area of a rectangle with length 8cm and width 5cm.", "options": { "A": "13cm²", "B": "26cm²", "C": "40cm²", "D": "50cm²" }, "correct": "C", "explanation": "Area = Length × Width = \\(8 \\times 5 = 40cm^2\\)." },
  { "id": 12, "text": "Find the perimeter of a square with side 6cm.", "options": { "A": "12cm", "B": "24cm", "C": "36cm", "D": "18cm" }, "correct": "B", "explanation": "Perimeter = 4 × side = \\(4 \\times 6 = 24cm\\)." },
  { "id": 13, "text": "What is the value of \\( 5^2 - 3^2 \\)?", "options": { "A": "4", "B": "8", "C": "16", "D": "25" }, "correct": "C", "explanation": "\\(25 - 9 = 16\\)." },
  { "id": 14, "text": "Express 45% as a fraction in its lowest term.", "options": { "A": "9/20", "B": "4/5", "C": "3/4", "D": "1/2" }, "correct": "A", "explanation": "\\(45/100\\). Divide both by 5: \\(9/20\\)." },
  { "id": 15, "text": "Find the simple interest on ₦5000 for 2 years at 5% per annum.", "options": { "A": "₦250", "B": "₦500", "C": "₦750", "D": "₦1000" }, "correct": "B", "explanation": "\\(I = \\frac{PRT}{100} = \\frac{5000 \\times 5 \\times 2}{100} = 50 \\times 10 = 500\\)." },
  { "id": 16, "text": "If the cost of 5 books is ₦2500, what is the cost of 1 book?", "options": { "A": "₦400", "B": "₦500", "C": "₦600", "D": "₦450" }, "correct": "B", "explanation": "\\(2500 \\div 5 = 500\\)." },
  { "id": 17, "text": "Convert 1.25 to percentage.", "options": { "A": "12.5%", "B": "125%", "C": "0.125%", "D": "1.25%" }, "correct": "B", "explanation": "\\(1.25 \\times 100\\% = 125\\%\\)." },
  { "id": 18, "text": "The sum of angles in a triangle is ______.", "options": { "A": "90°", "B": "180°", "C": "270°", "D": "360°" }, "correct": "B", "explanation": "The interior angles of any triangle always sum to 180°." },
  { "id": 19, "text": "Find the circumference of a circle with radius 7cm (Take \\(\\pi = 22/7\\)).", "options": { "A": "22cm", "B": "44cm", "C": "154cm", "D": "88cm" }, "correct": "B", "explanation": "\\(C = 2\\pi r = 2 \\times \\frac{22}{7} \\times 7 = 2 \\times 22 = 44cm\\)." },
  { "id": 20, "text": "Find the mean of 2, 4, 6, 8, 10.", "options": { "A": "4", "B": "5", "C": "6", "D": "7" }, "correct": "C", "explanation": "Sum = 30. Count = 5. Mean = \\(30/5 = 6\\)." },
  { "id": 21, "text": "What is the mode of 3, 5, 2, 5, 7, 5, 8?", "options": { "A": "3", "B": "5", "C": "7", "D": "8" }, "correct": "B", "explanation": "Mode is the number that appears most frequently. 5 appears 3 times." },
  { "id": 22, "text": "Find the median of 1, 3, 5, 7, 9.", "options": { "A": "3", "B": "5", "C": "7", "D": "9" }, "correct": "B", "explanation": "The middle number in the sorted list is 5." },
  { "id": 23, "text": "Simplify \\( -5 - (-3) \\).", "options": { "A": "-8", "B": "-2", "C": "2", "D": "8" }, "correct": "B", "explanation": "Minus minus becomes plus: \\(-5 + 3 = -2\\)." },
  { "id": 24, "text": "Expand \\( (x + 2)(x + 3) \\).", "options": { "A": "x² + 5x + 6", "B": "x² + 6x + 5", "C": "x² + x + 6", "D": "x² + 5x + 5" }, "correct": "A", "explanation": "\\(x(x) + x(3) + 2(x) + 2(3) = x^2 + 3x + 2x + 6 = x^2 + 5x + 6\\)." },
