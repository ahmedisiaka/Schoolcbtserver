  { "id": 32, "text": "Which of these affects posture?", "options": { "A": "Good diet", "B": "Bad habits/sitting wrongly", "C": "Exercise", "D": "Fresh air" }, "correct": "B", "explanation": "Poor habits cause deformity." },
