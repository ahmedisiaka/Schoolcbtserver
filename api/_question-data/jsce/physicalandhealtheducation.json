[
  { "id": 1, "text": "Which of these is a field event in athletics?", "options": { "A": "100m race", "B": "High jump", "C": "Relay", "D": "Hurdles" }, "correct": "B", "explanation": "High jump is performed on the field, not the track." },
  { "id": 2, "text": "The game of football is played by ______ players per team.", "options": { "A": "10", "B": "11", "C": "12", "D": "15" }, "correct": "B", "explanation": "A standard football team has 11 players." },
  { "id": 3, "text": "Which nutrient provides energy?", "options": { "A": "Vitamin", "B": "Carbohydrate", "C": "Water", "D": "Mineral" }, "correct": "B", "explanation": "Carbohydrates are the body's main energy source." },
  { "id": 4, "text": "First aid is given to ______.", "options": { "A": "Cure the victim", "B": "Save life before doctor arrives", "C": "Make the victim sleep", "D": "Punish the victim" }, "correct": "B", "explanation": "It is immediate temporary care to save life." },
  { "id": 5, "text": "Which of these is a racket game?", "options": { "A": "Football", "B": "Tennis", "C": "Basketball", "D": "Volleyball" }, "correct": "B", "explanation": "Tennis is played with a racket." },
  { "id": 6, "text": "The baton is used in ______.", "options": { "A": "High jump", "B": "Relay race", "C": "Javelin", "D": "Shot put" }, "correct": "B", "explanation": "Relay runners pass the baton." },
  { "id": 7, "text": "Dehydration is the loss of ______.", "options": { "A": "Blood", "B": "Water", "C": "Food", "D": "Air" }, "correct": "B", "explanation": "Excessive loss of body fluids." },
  { "id": 8, "text": "Which posture is best for sitting?", "options": { "A": "Slouching", "B": "Upright", "C": "Leaning back far", "D": "Crossed legs always" }, "correct": "B", "explanation": "Sitting upright supports the spine." },
  { "id": 9, "text": "Which of these is a communicable disease?", "options": { "A": "Cancer", "B": "Measles", "C": "Diabetes", "D": "Asthma" }, "correct": "B", "explanation": "Measles spreads from person to person." },
  { "id": 10, "text": "The heavy ball used in athletics is for ______.", "options": { "A": "Discus", "B": "Shot put", "C": "Javelin", "D": "Soccer" }, "correct": "B", "explanation": "Shot put involves throwing a heavy metal ball." },
  { "id": 11, "text": "Swimming strokes include ______.", "options": { "A": "Running", "B": "Freestyle", "C": "Dribbling", "D": "Serving" }, "correct": "B", "explanation": "Freestyle (Front Crawl) is a swimming style." },
  { "id": 12, "text": "Physical fitness involves ______.", "options": { "A": "Sleeping well", "B": "Body's ability to work without fatigue", "C": "Eating too much", "D": "Watching TV" }, "correct": "B", "explanation": "Ability to perform tasks effectively." },
  { "id": 13, "text": "Which vitamin helps eyesight?", "options": { "A": "Vitamin A", "B": "Vitamin C", "C": "Vitamin D", "D": "Vitamin K" }, "correct": "A", "explanation": "Vitamin A is essential for vision." },
  { "id": 14, "text": "A dislocation affects the ______.", "options": { "A": "Skin", "B": "Joint", "C": "Blood", "D": "Hair" }, "correct": "B", "explanation": "Displacement of bones at a joint." },
  { "id": 15, "text": "The referee controls the game in ______.", "options": { "A": "Tennis", "B": "Football", "C": "Cricket", "D": "Golf" }, "correct": "B", "explanation": "The official in charge of a football match." },
  { "id": 16, "text": "Drug abuse is ______.", "options": { "A": "Using drugs as prescribed", "B": "Misuse of drugs", "C": "Selling drugs", "D": "Buying drugs" }, "correct": "B", "explanation": "Using drugs without prescription or excessively." },
  { "id": 17, "text": "Which of these is an indoor game?", "options": { "A": "Football", "B": "Table Tennis", "C": "Cricket", "D": "Rugby" }, "correct": "B", "explanation": "Played indoors on a table." },
  { "id": 18, "text": "The starter uses a ______ to start a race.", "options": { "A": "Bell", "B": "Gun/Pistol", "C": "Whistle", "D": "Flag" }, "correct": "B", "explanation": "A starting gun signals the beginning." },
  { "id": 19, "text": "Which organ pumps blood?", "options": { "A": "Liver", "B": "Heart", "C": "Lungs", "D": "Kidney" }, "correct": "B", "explanation": "The heart circulates blood." },
  { "id": 20, "text": "A marathon is a ______ distance race.", "options": { "A": "Short", "B": "Long", "C": "Middle", "D": "Sprint" }, "correct": "B", "explanation": "42.195 km long-distance run." },
  { "id": 21, "text": "Which of these is not a swimming stroke?", "options": { "A": "Butterfly", "B": "Breaststroke", "C": "Backstroke", "D": "Dribble" }, "correct": "D", "explanation": "Dribbling is for ball games." },
  { "id": 22, "text": "Personal hygiene refers to cleanliness of the ______.", "options": { "A": "School", "B": "Body", "C": "Car", "D": "House" }, "correct": "B", "explanation": "Care of one's own body." },
  { "id": 23, "text": "Which of these is a track event?", "options": { "A": "Long jump", "B": "100m sprint", "C": "Shot put", "D": "High jump" }, "correct": "B", "explanation": "Running events on the track." },
  { "id": 24, "text": "Volleyball is played by ______ players per team.", "options": { "A": "5", "B": "6", "C": "7", "D": "11" }, "correct": "B", "explanation": "Standard volleyball team size." },
  { "id": 25, "text": "Which nutrient builds the body?", "options": { "A": "Protein", "B": "Fat", "C": "Carbohydrate", "D": "Water" }, "correct": "A", "explanation": "Proteins repair and build tissues." },
  { "id": 26, "text": "A sprain is an injury to a ______.", "options": { "A": "Bone", "B": "Ligament", "C": "Muscle", "D": "Skin" }, "correct": "B", "explanation": "Stretching/tearing of ligaments." },
  { "id": 27, "text": "The Olympic Games are held every ______ years.", "options": { "A": "2", "B": "4", "C": "5", "D": "10" }, "correct": "B", "explanation": "Quadrennial event." },
  { "id": 28, "text": "Which of these helps to prevent disease?", "options": { "A": "Dirty water", "B": "Vaccination/Immunization", "C": "Insects", "D": "Uncovered food" }, "correct": "B", "explanation": "Builds immunity against diseases." },
  { "id": 29, "text": "The duration of a football match is ______ minutes.", "options": { "A": "45", "B": "60", "C": "90", "D": "100" }, "correct": "C", "explanation": "Two halves of 45 mins." },
