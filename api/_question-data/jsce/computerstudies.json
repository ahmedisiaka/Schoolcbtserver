[
  { "id": 1, "text": "A computer is an electronic machine that ______.", "options": { "A": "Cooks food", "B": "Accepts data and processes it", "C": "Washes clothes", "D": "Generates electricity" }, "correct": "B", "explanation": "It processes input into output (information)." },
  { "id": 2, "text": "The physical parts of a computer are called ______.", "options": { "A": "Software", "B": "Hardware", "C": "Peopleware", "D": "Firmware" }, "correct": "B", "explanation": "Hardware refers to tangible components." },
  { "id": 3, "text": "Which of these is an input device?", "options": { "A": "Monitor", "B": "Printer", "C": "Keyboard", "D": "Speaker" }, "correct": "C", "explanation": "Keyboards are used to enter data." },
  { "id": 4, "text": "CPU stands for ______.", "options": { "A": "Central Processing Unit", "B": "Control Power Unit", "C": "Computer Personal Unit", "D": "Central Power Unit" }, "correct": "A", "explanation": "The brain of the computer." },
  { "id": 5, "text": "Which of these is an output device?", "options": { "A": "Mouse", "B": "Scanner", "C": "Monitor", "D": "Joystick" }, "correct": "C", "explanation": "Monitors display the results of processing." },
  { "id": 6, "text": "Data processed becomes ______.", "options": { "A": "Raw facts", "B": "Information", "C": "Garbage", "D": "Input" }, "correct": "B", "explanation": "Information is meaningful processed data." },
  { "id": 7, "text": "The brain of the computer is the ______.", "options": { "A": "Monitor", "B": "Keyboard", "C": "CPU", "D": "Mouse" }, "correct": "C", "explanation": "It performs all calculations and logic." },
  { "id": 8, "text": "Which key is used to capitalize letters?", "options": { "A": "Enter", "B": "Shift/Caps Lock", "C": "Ctrl", "D": "Alt" }, "correct": "B", "explanation": "Caps Lock or holding Shift creates uppercase letters." },
  { "id": 9, "text": "RAM stands for ______.", "options": { "A": "Read Access Memory", "B": "Random Access Memory", "C": "Read All Memory", "D": "Random All Memory" }, "correct": "B", "explanation": "Temporary working memory." },
  { "id": 10, "text": "Which of these is system software?", "options": { "A": "MS Word", "B": "Windows 10", "C": "CorelDraw", "D": "Excel" }, "correct": "B", "explanation": "Windows is an Operating System (System Software)." },
  { "id": 11, "text": "A byte consists of ______ bits.", "options": { "A": "4", "B": "8", "C": "16", "D": "32" }, "correct": "B", "explanation": "8 bits make 1 byte." },
  { "id": 12, "text": "The main circuit board is called the ______.", "options": { "A": "Motherboard", "B": "Fatherboard", "C": "Keyboard", "D": "Breadboard" }, "correct": "A", "explanation": "It holds the CPU, memory, and connectors." },
  { "id": 13, "text": "Which device is used for clicking and pointing?", "options": { "A": "Keyboard", "B": "Mouse", "C": "Scanner", "D": "Printer" }, "correct": "B", "explanation": "The mouse controls the cursor." },
  { "id": 14, "text": "What does ALU stand for?", "options": { "A": "Arithmetic Logic Unit", "B": "All Logic Unit", "C": "Arithmetic Long Unit", "D": "Access Logic Unit" }, "correct": "A", "explanation": "Part of CPU that handles math and logic." },
  { "id": 15, "text": "Which of these is a storage device?", "options": { "A": "Monitor", "B": "Hard Disk", "C": "Speaker", "D": "Plotter" }, "correct": "B", "explanation": "Hard disks store data permanently." },
  { "id": 16, "text": "The blinking bar on the screen is called ______.", "options": { "A": "Pointer", "B": "Cursor", "C": "Arrow", "D": "Line" }, "correct": "B", "explanation": "Indicates where text will appear." },
  { "id": 17, "text": "Software that protects against viruses is ______.", "options": { "A": "MS Word", "B": "Antivirus", "C": "Excel", "D": "Paint" }, "correct": "B", "explanation": "Detects and removes malware." },
  { "id": 18, "text": "Which generation of computers used vacuum tubes?", "options": { "A": "First", "B": "Second", "C": "Third", "D": "Fourth" }, "correct": "A", "explanation": "1st Gen (1940s-50s) used vacuum tubes." },
  { "id": 19, "text": "ICT stands for ______.", "options": { "A": "Information Communication Technology", "B": "Internet Computer Technology", "C": "Information Computer Transfer", "D": "Internal Communication Tech" }, "correct": "A", "explanation": "Standard acronym for tech in communication." },
  { "id": 20, "text": "Which key deletes characters to the left?", "options": { "A": "Delete", "B": "Backspace", "C": "Enter", "D": "Spacebar" }, "correct": "B", "explanation": "Backspace erases backwards." },
  { "id": 21, "text": "A printed copy of a document is called ______.", "options": { "A": "Soft copy", "B": "Hard copy", "C": "Scan copy", "D": "File copy" }, "correct": "B", "explanation": "Physical paper output." },
  { "id": 22, "text": "The 'Start' button is found on the ______.", "options": { "A": "Title bar", "B": "Taskbar", "C": "Menu bar", "D": "Scroll bar" }, "correct": "B", "explanation": "Usually at the bottom left of the desktop taskbar." },
  { "id": 23, "text": "Which of these is application software?", "options": { "A": "Linux", "B": "MS Word", "C": "Unix", "D": "DOS" }, "correct": "B", "explanation": "Designed for specific user tasks (word processing)." },
  { "id": 24, "text": "ROM stands for ______.", "options": { "A": "Read Only Memory", "B": "Random Only Memory", "C": "Read On Memory", "D": "Random On Memory" }, "correct": "A", "explanation": "Permanent memory containing boot instructions." },
  { "id": 25, "text": "Which device converts hard copy to soft copy?", "options": { "A": "Printer", "B": "Scanner", "C": "Monitor", "D": "Speaker" }, "correct": "B", "explanation": "Scanners digitize physical documents." },
  { "id": 26, "text": "The internet is a global network of ______.", "options": { "A": "Cars", "B": "Computers", "C": "Televisions", "D": "Phones only" }, "correct": "B", "explanation": "Interconnected computer networks." },
  { "id": 27, "text": "Which logic gate outputs 1 only if both inputs are 1?", "options": { "A": "OR", "B": "AND", "C": "NOT", "D": "NAND" }, "correct": "B", "explanation": "AND gate requires all inputs to be true." },
  { "id": 28, "text": "1 Kilobyte (KB) is equal to ______ bytes.", "options": { "A": "100", "B": "1000", "C": "1024", "D": "1048" }, "correct": "C", "explanation": "Standard binary measurement (2^10)." },
  { "id": 29, "text": "Which of these is a volatile memory?", "options": { "A": "ROM", "B": "Hard Disk", "C": "RAM", "D": "Flash Drive" }, "correct": "C", "explanation": "RAM loses data when power is off." },
  { "id": 30, "text": "Who is the father of the computer?", "options": { "A": "Bill Gates", "B": "Charles Babbage", "C": "Steve Jobs", "D": "Blaise Pascal" }, "correct": "B", "explanation": "Designed the Analytical Engine." },
  { "id": 31, "text": "Which key moves the cursor to the next line?", "options": { "A": "Shift", "B": "Enter/Return", "C": "Tab", "D": "Esc" }, "correct": "B", "explanation": "Creates a new paragraph/line." },
  { "id": 32, "text": "Which of these is NOT an operating system?", "options": { "A": "Windows", "B": "Android", "C": "Google Chrome", "D": "Linux" }, "correct": "C", "explanation": "Chrome is a web browser." },
  { "id": 33, "text": "The longest key on the keyboard is ______.", "options": { "A": "Enter", "B": "Spacebar", "C": "Shift", "D": "Backspace" }, "correct": "B", "explanation": "Used to insert spaces." },
  { "id": 34, "text": "Which port connects a flash drive?", "options": { "A": "VGA", "B": "USB", "C": "HDMI", "D": "Audio" }, "correct": "B", "explanation": "Universal Serial Bus." },
  { "id": 35, "text": "Spreadsheet software is used for ______.", "options": { "A": "Drawing", "B": "Calculations/Charts", "C": "Writing letters", "D": "Playing music" }, "correct": "B", "explanation": "Excel handles numerical data." },
  { "id": 36, "text": "Which of these is a computer ethic?", "options": { "A": "Hacking", "B": "Respecting privacy", "C": "Piracy", "D": "Spreading viruses" }, "correct": "B", "explanation": "Ethical behavior involves respecting others' data." },
  { "id": 37, "text": "What does WWW stand for?", "options": { "A": "World Wide Web", "B": "World Web Wide", "C": "Wide World Web", "D": "Web Wide World" }, "correct": "A", "explanation": "System of interlinked hypertext documents." },
  { "id": 38, "text": "A group of 4 bits is called a ______.", "options": { "A": "Byte", "B": "Nibble", "C": "Bit", "D": "Word" }, "correct": "B", "explanation": "Half a byte." },
  { "id": 39, "text": "Which generation used transistors?", "options": { "A": "First", "B": "Second", "C": "Third", "D": "Fourth" }, "correct": "B", "explanation": "2nd Gen (late 50s-60s) replaced tubes with transistors." },
  { "id": 40, "text": "The command to cut text is ______.", "options": { "A": "Ctrl + C", "B": "Ctrl + X", "C": "Ctrl + V", "D": "Ctrl + P" }, "correct": "B", "explanation": "Standard shortcut for Cut." },
  { "id": 41, "text": "Which of these is an impact printer?", "options": { "A": "LaserJet", "B": "InkJet", "C": "Dot Matrix", "D": "Thermal" }, "correct": "C", "explanation": "Strikes a ribbon against paper." },
  { "id": 42, "text": "Booting refers to ______.", "options": { "A": "Kicking the computer", "B": "Starting up the computer", "C": " shutting down", "D": "Installing apps" }, "correct": "B", "explanation": "Loading the OS into memory." },
  { "id": 43, "text": "Which logic gate inverts the input?", "options": { "A": "AND", "B": "OR", "C": "NOT", "D": "NOR" }, "correct": "C", "explanation": "NOT gate outputs the opposite (0->1, 1->0)." },
  { "id": 44, "text": "The intersection of a row and column in Excel is a ______.", "options": { "A": "Table", "B": "Cell", "C": "Box", "D": "Grid" }, "correct": "B", "explanation": "Basic unit of a spreadsheet." },
  { "id": 45, "text": "Which device connects a computer to the internet?", "options": { "A": "Printer", "B": "Modem/Router", "C": "Scanner", "D": "Monitor" }, "correct": "B", "explanation": "Modulates/Demodulates signals." },
  { "id": 46, "text": "Soft copy is displayed on the ______.", "options": { "A": "Paper", "B": "Monitor", "C": "Keyboard", "D": "Mouse" }, "correct": "B", "explanation": "Digital version on screen." },
  { "id": 47, "text": "Which key helps to escape a command?", "options": { "A": "Enter", "B": "Esc", "C": "Alt", "D": "Ctrl" }, "correct": "B", "explanation": "Escape key cancels operations." },
  { "id": 48, "text": "Search engines are used to ______.", "options": { "A": "Type documents", "B": "Find information online", "C": "Draw pictures", "D": "Listen to music" }, "correct": "B", "explanation": "Google, Bing, etc." },
  { "id": 49, "text": "Which of these prevents eye strain?", "options": { "A": "Staring at screen", "B": "Using anti-glare screen", "C": "Sitting very close", "D": "Working in darkness" }, "correct": "B", "explanation": "Reduces light reflection." },
  { "id": 50, "text": "The first calculating device is ______.", "options": { "A": "Computer", "B": "Abacus", "C": "Calculator", "D": "Phone" }, "correct": "B", "explanation": "Ancient counting tool." },
  { "id": 51, "text": "GUI stands for ______.", "options": { "A": "Graphical User Interface", "B": "General User Interface", "C": "Global User Interface", "D": "Graphical Unit Interface" }, "correct": "A", "explanation": "Visual way to interact with computers (icons, windows)." },
  { "id": 52, "text": "Which file extension represents a Word document?", "options": { "A": ".mp3", "B": ".docx", "C": ".jpg", "D": ".xls" }, "correct": "B", "explanation": "Standard Word format." },
  { "id": 53, "text": "Recycle Bin stores ______.", "options": { "A": "Important files", "B": "Deleted files", "C": "New files", "D": "Viruses" }, "correct": "B", "explanation": "Temporary holding for deleted items." },
  { "id": 54, "text": "Which of these is a pointing device?", "options": { "A": "Keyboard", "B": "Joystick", "C": "Printer", "D": "Scanner" }, "correct": "B", "explanation": "Used for gaming or controlling cursor." },
  { "id": 55, "text": "The base of the binary number system is ______.", "options": { "A": "10", "B": "2", "C": "8", "D": "16" }, "correct": "B", "explanation": "Base 2 (0 and 1)." },
  { "id": 56, "text": "UPS stands for ______.", "options": { "A": "United Power Supply", "B": "Uninterruptible Power Supply", "C": "Under Power System", "D": "Universal Power Source" }, "correct": "B", "explanation": "Provides battery backup power." },
  { "id": 57, "text": "Which command pastes text?", "options": { "A": "Ctrl + P", "B": "Ctrl + V", "C": "Ctrl + C", "D": "Ctrl + X" }, "correct": "B", "explanation": "Standard shortcut for Paste." },
  { "id": 58, "text": "A folder is used to ______.", "options": { "A": "Delete files", "B": "Organize/store files", "C": "Print files", "D": "Scan files" }, "correct": "B", "explanation": "Container for files." },
  { "id": 59, "text": "Which of these is a threat to computers?", "options": { "A": "Antivirus", "B": "Virus/Malware", "C": "Firewall", "D": "Password" }, "correct": "B", "explanation": "Malicious software." },
  { "id": 60, "text": "The outcome of data processing is ______.", "options": { "A": "Data", "B": "Information", "C": "Input", "D": "Raw facts" }, "correct": "B", "explanation": "Processed data." },
  { "id": 61, "text": "Which key is used to refresh a page?", "options": { "A": "F1", "B": "F5", "C": "F12", "D": "Esc" }, "correct": "B", "explanation": "Standard refresh key." },
  { "id": 62, "text": "Which of these is a search engine?", "options": { "A": "Facebook", "B": "Google", "C": "Whatsapp", "D": "Instagram" }, "correct": "B", "explanation": "Tool for searching the web." },
  { "id": 63, "text": "To shut down, you go to the ______ menu.", "options": { "A": "File", "B": "Start", "C": "Edit", "D": "View" }, "correct": "B", "explanation": "Start menu contains power options." },
  { "id": 64, "text": "E-mail stands for ______.", "options": { "A": "Electric Mail", "B": "Electronic Mail", "C": "Easy Mail", "D": "Express Mail" }, "correct": "B", "explanation": "Digital messaging." },
  { "id": 65, "text": "Which of these is a logic gate?", "options": { "A": "IF", "B": "AND", "C": "WHEN", "D": "THEN" }, "correct": "B", "explanation": "AND, OR, NOT are basic gates." },
  { "id": 66, "text": "Which device is essential for video calls?", "options": { "A": "Printer", "B": "Webcam", "C": "Scanner", "D": "Plotter" }, "correct": "B", "explanation": "Captures video input." },
  { "id": 67, "text": "The main component of 3rd generation computers was ______.", "options": { "A": "Vacuum tubes", "B": "Integrated Circuits (IC)", "C": "Transistors", "D": "Microprocessors" }, "correct": "B", "explanation": "ICs replaced individual transistors." },
  { "id": 68, "text": "Which of these is NOT a hardware?", "options": { "A": "Mouse", "B": "Windows", "C": "Keyboard", "D": "Screen" }, "correct": "B", "explanation": "Windows is software (OS)." },
  { "id": 69, "text": "1 Megabyte (MB) is approximately ______.", "options": { "A": "1000 Bytes", "B": "1 Million Bytes", "C": "1 Billion Bytes", "D": "1 Trillion Bytes" }, "correct": "B", "explanation": "1024 x 1024 bytes." },
  { "id": 70, "text": "Which key takes a screenshot?", "options": { "A": "Scroll Lock", "B": "Print Screen", "C": "Pause", "D": "Insert" }, "correct": "B", "explanation": "Captures the screen image." }
]