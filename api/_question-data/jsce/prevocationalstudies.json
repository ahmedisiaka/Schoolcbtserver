[
  { "id": 1, "text": "Which of these is a monocotyledonous plant?", "options": { "A": "Bean", "B": "Maize", "C": "Groundnut", "D": "Mango" }, "correct": "B", "explanation": "Maize has one seed leaf (cotyledon)." },
  { "id": 2, "text": "The removal of weeds from the farm is called ______.", "options": { "A": "Planting", "B": "Weeding", "C": "Harvesting", "D": "Mulching" }, "correct": "B", "explanation": "Weeding is the removal of unwanted plants." },
  { "id": 3, "text": "Which of these is a source of protein?", "options": { "A": "Yam", "B": "Rice", "C": "Beans", "D": "Cassava" }, "correct": "C", "explanation": "Beans are legumes rich in protein." },
  { "id": 4, "text": "The kitchen equipment used for baking is ______.", "options": { "A": "Blender", "B": "Toaster", "C": "Oven", "D": "Kettle" }, "correct": "C", "explanation": "Ovens are specifically designed for baking." },
  { "id": 5, "text": "A tool used for digging soil is ______.", "options": { "A": "Cutlass", "B": "Spade", "C": "Rake", "D": "Shears" }, "correct": "B", "explanation": "A spade is used for digging and lifting soil." },
  { "id": 6, "text": "Puberty is the period of ______.", "options": { "A": "Old age", "B": "Childhood", "C": "Sexual maturity", "D": "Infancy" }, "correct": "C", "explanation": "Puberty marks the onset of sexual maturity." },
  { "id": 7, "text": "Which of these is a method of preserving fish?", "options": { "A": "Boiling", "B": "Smoking", "C": "Eating", "D": "Washing" }, "correct": "B", "explanation": "Smoking dries fish to prevent spoilage." },
  { "id": 8, "text": "Cosmetics are used for ______.", "options": { "A": "Eating", "B": "Cleaning", "C": "Beautification", "D": "Farming" }, "correct": "C", "explanation": "Cosmetics enhance appearance." },
  { "id": 9, "text": "Which soil type is best for farming?", "options": { "A": "Sandy", "B": "Clay", "C": "Loamy", "D": "Stony" }, "correct": "C", "explanation": "Loam has the right balance of nutrients and drainage." },
  { "id": 10, "text": "The primary function of carbohydrates is to ______.", "options": { "A": "Build body", "B": "Provide energy", "C": "Fight disease", "D": "Repair tissues" }, "correct": "B", "explanation": "Carbohydrates are energy-giving foods." },
  { "id": 11, "text": "Which of these is a cash crop?", "options": { "A": "Cocoa", "B": "Yam", "C": "Cassava", "D": "Maize" }, "correct": "A", "explanation": "Cash crops are grown primarily for sale/export." },
  { "id": 12, "text": "Good posture helps to prevent ______.", "options": { "A": "Hunger", "B": "Fatigue", "C": "Malaria", "D": "Fever" }, "correct": "B", "explanation": "Good posture reduces muscle strain and fatigue." },
  { "id": 13, "text": "Which of these is a farm animal?", "options": { "A": "Lion", "B": "Goat", "C": "Tiger", "D": "Elephant" }, "correct": "B", "explanation": "Goats are domesticated livestock." },
  { "id": 14, "text": "A balanced diet contains ______.", "options": { "A": "Only proteins", "B": "Only carbohydrates", "C": "All nutrients in right proportion", "D": "Fatty foods" }, "correct": "C", "explanation": "Balanced diets include all food groups." },
  { "id": 15, "text": "The process of transferring seedlings is called ______.", "options": { "A": "Planting", "B": "Transplanting", "C": "Sowing", "D": "Thinning" }, "correct": "B", "explanation": "Moving seedlings from nursery to field." },
  { "id": 16, "text": "Which textile is made from animals?", "options": { "A": "Cotton", "B": "Wool", "C": "Nylon", "D": "Linen" }, "correct": "B", "explanation": "Wool comes from sheep." },
  { "id": 17, "text": "Fertilizers are added to soil to ______.", "options": { "A": "Kill pests", "B": "Improve fertility", "C": "Stop erosion", "D": "Kill weeds" }, "correct": "B", "explanation": "Fertilizers provide nutrients." },
  { "id": 18, "text": "Personal hygiene refers to ______.", "options": { "A": "Cleaning the house", "B": "Cleanliness of the body", "C": "Washing cars", "D": "Cleaning school" }, "correct": "B", "explanation": "Hygiene of one's own body." },
  { "id": 19, "text": "Which of these is a tuber crop?", "options": { "A": "Rice", "B": "Beans", "C": "Yam", "D": "Tomato" }, "correct": "C", "explanation": "Yams grow underground as tubers." },
  { "id": 20, "text": "A nuclear family consists of ______.", "options": { "A": "Father, mother, children", "B": "Uncles and aunts", "C": "Grandparents", "D": "Friends" }, "correct": "A", "explanation": "The basic family unit." },
  { "id": 21, "text": "Which animal provides milk?", "options": { "A": "Chicken", "B": "Cow", "C": "Pig", "D": "Duck" }, "correct": "B", "explanation": "Cows are dairy animals." },
  { "id": 22, "text": "Dehydration is caused by loss of ______.", "options": { "A": "Blood", "B": "Water", "C": "Food", "D": "Air" }, "correct": "B", "explanation": "Lack of water in the body." },
  { "id": 23, "text": "Which farming tool is used for cutting grass?", "options": { "A": "Shovel", "B": "Cutlass", "C": "Rake", "D": "Hand trowel" }, "correct": "B", "explanation": "A cutlass is used for slashing." },
  { "id": 24, "text": "Vitamin C prevents ______.", "options": { "A": "Rickets", "B": "Scurvy", "C": "Beriberi", "D": "Night blindness" }, "correct": "B", "explanation": "Scurvy is a Vitamin C deficiency disease." },
  { "id": 25, "text": "Crop rotation helps to ______.", "options": { "A": "Deplete soil", "B": "Maintain soil fertility", "C": "Increase pests", "D": "Waste land" }, "correct": "B", "explanation": "Changing crops prevents nutrient depletion." },
  { "id": 26, "text": "Which of these is a synthetic fibre?", "options": { "A": "Cotton", "B": "Silk", "C": "Nylon", "D": "Wool" }, "correct": "C", "explanation": "Nylon is man-made." },
  { "id": 27, "text": "Poultry refers to ______.", "options": { "A": "Cattle", "B": "Birds", "C": "Fish", "D": "Goats" }, "correct": "B", "explanation": "Domesticated birds (chicken, turkey)." },
  { "id": 28, "text": "A recipe is a set of instructions for ______.", "options": { "A": "Farming", "B": "Sewing", "C": "Cooking", "D": "Cleaning" }, "correct": "C", "explanation": "Guide for preparing food." },
  { "id": 29, "text": "Which of these is a cereal crop?", "options": { "A": "Yam", "B": "Rice", "C": "Beans", "D": "Orange" }, "correct": "B", "explanation": "Rice is a grain/cereal." },
  { "id": 30, "text": "Menstruation occurs in ______.", "options": { "A": "Males", "B": "Females", "C": "Children", "D": "Babies" }, "correct": "B", "explanation": "Biological process in females." },
  { "id": 31, "text": "Compost is a type of ______.", "options": { "A": "Soil", "B": "Manure", "C": "Pesticide", "D": "Seed" }, "correct": "B", "explanation": "Organic fertilizer from decayed matter." },
  { "id": 32, "text": "Boiling water kills ______.", "options": { "A": "Nutrients", "B": "Germs", "C": "Taste", "D": "Color" }, "correct": "B", "explanation": "Heat destroys pathogens." },
  { "id": 33, "text": "Which tool is used for gathering leaves?", "options": { "A": "Hoe", "B": "Rake", "C": "Axe", "D": "Spade" }, "correct": "B", "explanation": "Rakes gather loose debris." },
  { "id": 34, "text": "Kwashiorkor is caused by lack of ______.", "options": { "A": "Carbohydrate", "B": "Protein", "C": "Vitamin", "D": "Fat" }, "correct": "B", "explanation": "Severe protein deficiency." },
  { "id": 35, "text": "Irrigation is the artificial application of ______.", "options": { "A": "Fertilizer", "B": "Water", "C": "Manure", "D": "Seeds" }, "correct": "B", "explanation": "Watering crops artificially." },
  { "id": 36, "text": "Which of these is a cosmetic?", "options": { "A": "Broom", "B": "Powder", "C": "Pot", "D": "Spoon" }, "correct": "B", "explanation": "Powder is used for face makeup." },
  { "id": 37, "text": "Weeds compete with crops for ______.", "options": { "A": "Farmers", "B": "Nutrients", "C": "Tools", "D": "Markets" }, "correct": "B", "explanation": "They fight for space, light, and nutrients." },
  { "id": 38, "text": "Puberty usually starts between ages ______.", "options": { "A": "1-5", "B": "10-14", "C": "20-25", "D": "40-50" }, "correct": "B", "explanation": "Typical onset of adolescence." },
  { "id": 39, "text": "A place where seedlings are raised is ______.", "options": { "A": "Store", "B": "Nursery", "C": "Barn", "D": "Market" }, "correct": "B", "explanation": "Young plants are raised in a nursery." },
  { "id": 40, "text": "Which nutrient gives warmth?", "options": { "A": "Protein", "B": "Fat and Oil", "C": "Mineral", "D": "Water" }, "correct": "B", "explanation": "Fats provide insulation and energy." },
  { "id": 41, "text": "The main tool for tillage is ______.", "options": { "A": "Knife", "B": "Hoe", "C": "Shears", "D": "Sickle" }, "correct": "B", "explanation": "Hoes are used to till soil." },
  { "id": 42, "text": "Drug abuse can lead to ______.", "options": { "A": "Good health", "B": "Addiction", "C": "Success", "D": "Growth" }, "correct": "B", "explanation": "Misuse leads to dependency." },
