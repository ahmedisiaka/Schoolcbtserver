  { "id": 54, "text": "Rabbits are kept in a ______.", "options": { "A": "Pen", "B": "Hutch", "C": "Stable", "D": "Coop" }, "correct": "B", "explanation": "Housing for rabbits." },
  { "id": 55, "text": "Which fibre is natural?", "options": { "A": "Nylon", "B": "Cotton", "C": "Polyester", "D": "Acrylic" }, "correct": "B", "explanation": "Cotton grows on plants." },
  { "id": 56, "text": "Excess carbohydrate is stored as ______.", "options": { "A": "Muscle", "B": "Fat", "C": "Bone", "D": "Water" }, "correct": "B", "explanation": "Converted to fat for storage." },
