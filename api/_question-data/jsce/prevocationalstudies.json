  { "id": 47, "text": "Which animal is used for security?", "options": { "A": "Sheep", "B": "Dog", "C": "Goat", "D": "Pig" }, "correct": "B", "explanation": "Dogs guard homes." },
  { "id": 48, "text": "A house protects us from ______.", "options": { "A": "Friends", "B": "Weather", "C": "Food", "D": "Air" }, "correct": "B", "explanation": "Shelter from rain, sun, etc." },
  { "id": 49, "text": "Afforestation is ______.", "options": { "A": "Cutting trees", "B": "Planting trees", "C": "Burning bush", "D": "Selling wood" }, "correct": "B", "explanation": "Establishing forests by planting." },
  { "id": 50, "text": "Which of these is a vegetable?", "options": { "A": "Mango", "B": "Spinach", "C": "Rice", "D": "Yam" }, "correct": "B", "explanation": "Spinach is a leafy vegetable." },
  { "id": 51, "text": "The period between childhood and adulthood is ______.", "options": { "A": "Infancy", "B": "Adolescence", "C": "Old age", "D": "Toddler" }, "correct": "B", "explanation": "Teenage years." },
