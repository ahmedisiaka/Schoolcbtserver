  { "id": 59, "text": "What is the gestation period of a goat?", "options": { "A": "3 months", "B": "5 months", "C": "9 months", "D": "12 months" }, "correct": "B", "explanation": "Pregnancy lasts about 150 days." },
  { "id": 60, "text": "Which food group protects the body?", "options": { "A": "Vitamins", "B": "Carbohydrates", "C": "Fats", "D": "Sugars" }, "correct": "A", "explanation": "Vitamins boost immunity." },
  { "id": 61, "text": "Mixed farming involves ______.", "options": { "A": "Animals only", "B": "Crops only", "C": "Crops and Animals", "D": "Fishing" }, "correct": "C", "explanation": "Raising both simultaneously." },
  { "id": 62, "text": "Dry cleaning uses ______.", "options": { "A": "Water", "B": "Chemical solvents", "C": "Soap", "D": "Sand" }, "correct": "B", "explanation": "Cleaning without water." },
