{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "includeFiles": "api/_question-data/**"
    }
  },
  "headers": [
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/:path*",
      "destination": "/api/question-data?path=data/:path*"
    },
    {
      "source": "/server/api/:path*",
      "destination": "/api/:path*"
    }
  ]
}
